# Database
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Auth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxx
EMAIL_FROM=notifications@sindicato.report

# Cloudflare Email Routing (anonymous aliases)
CF_ZONE_ID=your_cloudflare_zone_id
CF_API_TOKEN=your_api_token_with_email_routing_write_permissions

# Cloudflare Turnstile (invisible human verification)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
CF_TURNSTILE_SECRET=your_turnstile_secret_key

# AI (OpenRouter)
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxx

# Model routing
WRITING_MODEL=moonshot/kimi-k2-instant
TRANSLATION_MODEL=moonshot/kimi-k2-instant
CLERK_MODEL=nvidia/nemotron-3-super-120b-a12b:free
REPORT_MODEL=deepseek/deepseek-v3
PATTERN_MODEL=deepseek/deepseek-r1
TRIAGE_MODEL=deepseek/deepseek-v3
TAG_MODEL=openai/gpt-oss-120b:free
SCRAPER_MODEL=deepseek/deepseek-v3

# Payments (CoinGate primary, NexaPay backup)
COINGATE_API_KEY=your_coingate_api_key
NEXAPAY_API_KEY=your_nexapay_api_key

# Payments (Stripe for donations — Embedded Checkout)
# Prefer a restricted API key (rk_*) with read+write on Checkout Sessions only.
# Fall back to a secret key (sk_*) if you don't have a RAK configured.
# Get keys: https://dashboard.stripe.com/test/apikeys
STRIPE_RESTRICTED_KEY=rk_test_xxxxxxxxxxxxx
# STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxx

# App
NEXT_PUBLIC_BASE_URL=http://localhost:3000
CRON_SECRET=************************************

# Analytics (Umami Cloud)
NEXT_PUBLIC_UMAMI_URL=https://cloud.umami.is
NEXT_PUBLIC_UMAMI_WEBSITE_ID=your-umami-website-id
UMAMI_URL=https://api.umami.is/v1
UMAMI_API_KEY=your-umami-api-key
